<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Native AOT: a plain native exe. The compressed single-file bundle
         (.NET runtime packed inside) was flagged by 2 antivirus engines on
         VirusTotal; the native build by none (2026-10-24). -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <Company>moneyhippo</Company>
    <Product>FH2 Co-op Steam Helper</Product>
    <AssemblyTitle>FH2 Co-op Steam Helper</AssemblyTitle>
    <Description>Connects the FH2 co-op mod to Steam invites</Description>
    <Version>0.42.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Steamworks.NET" />
    <None Include="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Steamworks.NET" Version="2024.8.0" />
  </ItemGroup>

</Project>
